# Example environment variables for Nimbus mobile app
# 
# SECURITY NOTICE:
# - NEVER commit actual secrets to git
# - Use EXPO_PUBLIC_ prefix ONLY for non-sensitive client-exposed values
# - Store sensitive keys (Stripe, OpenAI, Firebase private keys) server-side only
# - For production, use platform secret managers (Railway, EAS Secrets, etc.)

# ====== CLIENT-EXPOSED VARS (safe to bundle in app) ======
# API endpoint - replace with your production URL
EXPO_PUBLIC_API_URL=https://nimbus-cannabis-mobile-production.up.railway.app

# CMS/Content API (optional)
EXPO_PUBLIC_CMS_API_URL=https://cms.example.com

# Firebase client config (public keys - safe to expose)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENTID=

# OpenWeather API key (consider moving to backend for rate limit control)
EXPO_PUBLIC_OPENWEATHER_KEY=
# NOTE: `EXPO_PUBLIC_OPENWEATHER_KEY` is commonly used in mobile builds for
# weather-based features. Consider moving requests through a server-side proxy
# if you need stricter rate limits, request signing, or to keep the key private.

# White-label brand config (optional - defaults in code)
EXPO_PUBLIC_BRAND_NAME="Nimbus Cannabis OS"
EXPO_PUBLIC_BRAND_SLUG=nimbus-cannabis-mobile

# Debug mode (development only)
EXPO_PUBLIC_DEBUG=false

# ====== SERVER-SIDE ONLY (never expose to client) ======
# Sentry DSN for error tracking
SENTRY_DSN=
# Client (Expo) Sentry DSN - use only if you want to initialize Sentry in the
# bundled mobile app. This will be embedded in client builds if present.
EXPO_PUBLIC_SENTRY_DSN=

# Sentry Auth Token for uploading source maps during build (CI/CD)
SENTRY_AUTH_TOKEN=

# Firebase server credentials (NEVER expose these)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or use base64-encoded service account JSON:
FIREBASE_SERVICE_ACCOUNT_BASE64=

# JWT secret (32+ chars, mix of upper/lower/numbers/symbols)
JWT_SECRET=

# Database connection
DATABASE_URL=postgresql://user:pass@host:5432/dbname
DIRECT_DATABASE_URL=

# Stripe (server-side only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenAI / AI features
OPENAI_API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_BLOCK_SECONDS=60

# External APIs
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
WEATHER_CACHE_TTL_MS=300000
EXTERNAL_API_TIMEOUT_MS=5000

# Build secrets (base64-encoded, for CI/CD)
GOOGLE_SERVICES_JSON_BASE64=
GOOGLESERVICE_PLIST_BASE64=

# Stripe client keys (public - safe to expose)
STRIPE_PUBLISHABLE_KEY=
STRIPE_MERCHANT_ID=
